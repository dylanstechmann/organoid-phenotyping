{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "scholar": {
      "type": "local",
      "command": [
        "sh",
        ".agent-tools/mcp/launch.sh",
        "scholar_mcp.py"
      ],
      "enabled": true
    },
    "web": {
      "type": "local",
      "command": [
        "sh",
        ".agent-tools/mcp/launch.sh",
        "web_mcp.py"
      ],
      "enabled": true
    },
    "github": {
      "type": "local",
      "command": [
        "sh",
        ".agent-tools/mcp/gh_mcp.sh"
      ],
      "enabled": true
    },
    "context7": {
      "type": "local",
      "command": [
        "npx",
        "-y",
        "@upstash/context7-mcp"
      ],
      "enabled": true
    },
    "playwright": {
      "type": "local",
      "command": [
        "npx",
        "-y",
        "@playwright/mcp@latest"
      ],
      "enabled": true
    }
  }
}
